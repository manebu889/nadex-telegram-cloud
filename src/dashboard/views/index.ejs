<%- include('components/head') %>

    <div x-data="dashboard()" x-init="startPolling()"
        class="w-full max-w-6xl mx-auto px-5 py-8 md:px-10 md:py-14 flex flex-col flex-grow">

        <%- include('components/header') %>

        <!-- ===== Content Area ===== -->
        <main class="flex-grow">
            <!-- Metrics Grid (symmetric 4-up, collapses evenly) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

                <!-- Card 2: System Resources (2 Gauges) -->
                <div class="card sm:col-span-2 flex items-center justify-between">

                    <!-- Bagian Kiri (Teks) -->
                    <div class="flex flex-col justify-between h-full">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Resources Usage</span>

                        <div class="mt-2 space-y-2">
                            <!-- Info RAM -->
                            <div class="font-mono text-xs text-muted flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-accent"></span>
                                <span>RAM: <span x-text="stats.memory.used">0</span> / <span
                                        x-text="stats.memory.total">0</span></span>
                            </div>
                            <!-- Info Disk -->
                            <div class="font-mono text-xs text-muted flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-good"></span>
                                <span>DSK: <span x-text="stats.disk.used">0</span> / <span
                                        x-text="stats.disk.total">0</span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bagian Kanan (2 Gauge) -->
                    <div class="flex items-center gap-4 sm:gap-6">

                        <!-- Gauge 1: RAM (Cyan) -->
                        <div class="relative w-20 h-20 shrink-0">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 80 80">
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#1c2536" stroke-width="7" />
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#5eead4" stroke-width="7"
                                    stroke-linecap="round" stroke-dasharray="213.6"
                                    :stroke-dashoffset="213.6 - (213.6 * (parseFloat(stats.memory.percent) || 0) / 100)"
                                    class="transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="font-display font-semibold text-sm text-white"
                                    x-text="Math.floor(stats.memory.percent) + '%'">0%</span>
                            </div>
                        </div>

                        <!-- Gauge 2: Disk (Hijau) -->
                        <div class="relative w-20 h-20 shrink-0">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 80 80">
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#1c2536" stroke-width="7" />
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#34d399" stroke-width="7"
                                    stroke-linecap="round" stroke-dasharray="213.6"
                                    :stroke-dashoffset="213.6 - (213.6 * (parseFloat(stats.disk.percent) || 0) / 100)"
                                    class="transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="font-display font-semibold text-sm text-white"
                                    x-text="Math.floor(stats.disk.percent) + '%'">0%</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Card 3: Master Games -->
                <div class="card flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Master Games</span>
                        <div class="w-8 h-8 rounded-lg bg-good/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-good" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M9 3v18M4 8h16M4 16h16" />
                            </svg>
                        </div>
                    </div>
                    <div>
                        <div class="font-display font-semibold text-3xl text-white num-flicker"
                            x-text="stats.database.totalGames">0</div>
                        <p class="text-muted text-xs mt-2">Katalog game terdaftar</p>
                    </div>
                </div>

                <!-- Card 4: Storage Stats -->
                <div class="card flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Storage Stats</span>
                        <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M4 7a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M8 11h8M8 15h5" />
                            </svg>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="font-display font-semibold text-2xl text-white"
                                x-text="stats.database.totalAccounts">0</div>
                            <p class="text-muted text-[11px] mt-1">Akun Terenkripsi</p>
                        </div>
                        <div class="border-l border-line pl-3">
                            <div class="font-display font-semibold text-2xl text-white"
                                x-text="stats.database.totalFiles">0</div>
                            <p class="text-muted text-[11px] mt-1">File Terunggah</p>
                        </div>
                    </div>
                </div>

            </div>
        </main>

        <%- include('components/footer') %>
