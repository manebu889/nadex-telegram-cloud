<%- include('components/head') %>

    <div x-data="dashboard()" x-init="startPolling()"
        class="w-full max-w-6xl mx-auto px-5 py-8 md:px-10 md:py-14 flex flex-col flex-grow">

        <%- include('components/header') %>

        <!-- ===== Content Area ===== -->
        <main class="flex-grow">
            <!-- Metrics Grid (symmetric 4-up, collapses evenly) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

                <!-- Card 2: System Resources (2 Gauges) -->
                <div class="card sm:col-span-2 flex items-center justify-between">

                    <!-- Bagian Kiri (Teks) -->
                    <div class="flex flex-col justify-between h-full">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Resources Usage</span>

                        <div>
                            <div class="font-display font-semibold text-3xl text-white num-flicker"
                                x-text="stats.hostname"></div>
                        </div>

                        <div class="mt-2 space-y-2">
                            <!-- Info RAM -->
                            <div class="font-mono text-xs text-muted flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-accent"></span>
                                <span>RAM: <span x-text="stats.memory.used">0</span> / <span
                                        x-text="stats.memory.total">0</span></span>
                            </div>
                            <!-- Info Disk -->
                            <div class="font-mono text-xs text-muted flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-good"></span>
                                <span>DISK: <span x-text="stats.disk.used">0</span> / <span
                                        x-text="stats.disk.total">0</span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bagian Kanan (2 Gauge) -->
                    <div class="flex items-center gap-4 sm:gap-6">

                        <!-- Gauge 1: RAM (Cyan) -->
                        <div class="relative w-20 h-20 shrink-0">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 80 80">
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#1c2536" stroke-width="7" />
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#5eead4" stroke-width="7"
                                    stroke-linecap="round" stroke-dasharray="213.6"
                                    :stroke-dashoffset="213.6 - (213.6 * (parseFloat(stats.memory.percent) || 0) / 100)"
                                    class="transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="font-display font-semibold text-sm text-white"
                                    x-text="Math.floor(stats.memory.percent) + '%'">0%</span>
                            </div>
                        </div>

                        <!-- Gauge 2: Disk (Hijau) -->
                        <div class="relative w-20 h-20 shrink-0">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 80 80">
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#1c2536" stroke-width="7" />
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#34d399" stroke-width="7"
                                    stroke-linecap="round" stroke-dasharray="213.6"
                                    :stroke-dashoffset="213.6 - (213.6 * (parseFloat(stats.disk.percent) || 0) / 100)"
                                    class="transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="font-display font-semibold text-sm text-white"
                                    x-text="Math.floor(stats.disk.percent) + '%'">0%</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Card 3: Master Games -->
                <div class="card flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Master Accounts</span>
                        <div class="w-8 h-8 rounded-lg bg-good/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-good" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M9 3v18M4 8h16M4 16h16" />
                            </svg>
                        </div>
                    </div>
                    <div>
                        <div class="font-display font-semibold text-3xl text-white num-flicker"
                            x-text="stats.database.totalGames">0</div>
                        <p class="text-muted text-xs mt-2">Katalog platform terdaftar</p>
                    </div>
                </div>

                <!-- Card 4: Storage Stats -->
                <div class="card flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Storage Stats</span>
                        <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M4 7a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M8 11h8M8 15h5" />
                            </svg>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="font-display font-semibold text-2xl text-white"
                                x-text="stats.database.totalAccounts">0</div>
                            <p class="text-muted text-[11px] mt-1">Akun Terenkripsi</p>
                        </div>
                        <div class="border-l border-line pl-3">
                            <div class="font-display font-semibold text-2xl text-white"
                                x-text="stats.database.totalFiles">0</div>
                            <p class="text-muted text-[11px] mt-1">File Terunggah</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Activity Log Section -->
            <div class="mt-5 card flex flex-col">
                <div class="flex items-center justify-between border-b border-line pb-4 mb-4">
                    <div>
                        <h2 class="text-white font-display font-semibold text-lg" x-text="stats.uiStrings?.ACTIVITY_TITLE || 'Log Aktivitas'"></h2>
                        <p class="text-muted text-xs mt-1" x-text="stats.uiStrings?.ACTIVITY_SUBTITLE || '5 File terakhir yang diunggah'"></p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="text-muted font-mono text-[11px] uppercase tracking-widest border-b border-line text-center">
                                <th class="pb-3 px-3 font-medium w-10" x-text="stats.uiStrings?.TABLE_NO || 'NO'"></th>
                                <th class="pb-3 px-4 font-medium" x-text="stats.uiStrings?.TABLE_FILE || 'Nama File'"></th>
                                <th class="pb-3 px-4 font-medium" x-text="stats.uiStrings?.TABLE_CATEGORY || 'Kategori'"></th>
                                <th class="pb-3 px-4 font-medium" x-text="stats.uiStrings?.TABLE_LABEL || 'Label'"></th>
                                <th class="pb-3 px-4 font-medium" x-text="stats.uiStrings?.TABLE_TIME || 'Waktu'"></th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            <template x-if="!stats.recentActivity || stats.recentActivity.length === 0">
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-muted text-xs" x-text="stats.uiStrings?.NO_ACTIVITY || 'Belum ada aktivitas.'"></td>
                                </tr>
                            </template>
                            <template x-for="(file, index) in stats.recentActivity" :key="index">
                                <tr class="border-b border-line/50 hover:bg-white/[0.02] transition-colors group">
                                    <td class="py-3 px-3 text-center text-muted font-mono" x-text="index + 1"></td>
                                    <td class="py-3 px-4 text-ink truncate max-w-[200px]" :title="file.name">
                                        <div class="flex items-center justify-center gap-2">
                                            <span x-show="index === 0" class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-accent/20 text-accent uppercase tracking-wider" x-text="stats.uiStrings?.BADGE_NEW || 'Baru'"></span>
                                            <span x-text="file.name" class="font-medium text-center"></span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 text-muted whitespace-nowrap text-center" x-text="file.category"></td>
                                    <td class="py-3 px-4 text-center">
                                        <span class="px-2 py-1 rounded bg-panel2 border border-line text-xs text-muted truncate max-w-[100px] inline-block" :title="file.label" x-text="file.label"></span>
                                    </td>
                                    <td class="py-3 px-4 text-center whitespace-nowrap text-muted text-xs font-mono" x-text="formatTimeAgo(file.time)"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <%- include('components/footer') %>
