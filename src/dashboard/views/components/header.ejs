        <!-- ===== Header ===== -->
        <header class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between mb-10 shrink-0">
            <div class="flex items-center gap-4">
                <div
                    class="relative w-12 h-12 shrink-0 rounded-xl bg-panel2 border border-line flex items-center justify-center glow-border">
                    <div
                        class="relative w-12 h-12 shrink-0 rounded-xl bg-panel2 border border-line flex items-center justify-center glow-border overflow-hidden">
                        <img src="/assets/nadeshiko.webp" alt="Custom Icon" class="w-full h-full object-cover" />
                    </div>

                </div>
                <div>
                    <h1
                        class="font-display font-semibold text-2xl md:text-[26px] text-white tracking-tight leading-none">
                        NADEX CLOUD STORAGE
                    </h1>
                    <p class="text-muted text-sm mt-1.5 font-mono tracking-wide">SERVER &amp; DATABASE MONITORING</p>
                </div>
            </div>

            <!-- Status Badge -->
            <div class="flex items-center gap-3 self-start sm:self-auto rounded-full bg-panel border pl-3 pr-4 py-2"
                :class="isOnline ? 'border-good/30' : 'border-bad/30'">
                <span class="relative flex w-2.5 h-2.5">
                    <span class="absolute inline-flex h-full w-full rounded-full opacity-60"
                        :class="isOnline ? 'bg-good animate-ping' : 'bg-bad animate-ping'"></span>
                    <span class="relative inline-flex rounded-full w-2.5 h-2.5"
                        :class="isOnline ? 'bg-good' : 'bg-bad'"></span>
                </span>
                <span class="font-mono text-xs uppercase tracking-wider" :class="isOnline ? 'text-good' : 'text-bad'"
                    x-text="isOnline ? 'Online' : 'Offline'"></span>
            </div>
        </header>
